///|
test "a proof from CaDiCaL 3.1.0 verifies under both checkers" {
  let f = parse_dimacs(cadical_php6_cnf)
  assert_true(verify_proof(f, cadical_php6_proof))
  assert_true(verify_proof_rat(f, cadical_php6_proof))
}

///|
/// Acceptance is conditional: drop the final empty clause and the same proof
/// must fail, so the checker is not echoing back whatever it is handed.
test "the same proof is rejected without its empty clause" {
  let lines : Array[String] = []
  for l in cadical_php6_proof.split("\n") {
    lines.push(l.to_owned())
  }
  let mut body = ""
  let mut i = 0
  while i < lines.length() - 2 {
    body = body + lines[i] + "\n"
    i = i + 1
  }
  let f = parse_dimacs(cadical_php6_cnf)
  assert_false(verify_proof(f, body))
}